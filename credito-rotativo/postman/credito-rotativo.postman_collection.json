              "mode": "raw",
              "raw": "{\n  \"nome\": \"Carlos Souza\",\n  \"cpf\": \"910.220.330-02\",\n  \"score_credito\": 520,\n  \"atrasos_meses\": 0,\n  \"valor_fatura\": \"500.00\",\n  \"limite_disponivel\": \"4500.00\",\n  \"gastos_ultimos_meses\": [\n    \"500.00\",\n    \"500.00\",\n    \"500.00\",\n    \"500.00\",\n    \"500.00\",\n    \"500.00\"\n  ]\n}",
              "options": {
