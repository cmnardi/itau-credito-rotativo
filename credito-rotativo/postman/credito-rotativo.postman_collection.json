            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('campos do snapshot', () =>",
                  "  pm.expect(Object.keys(r)).to.include.members([",
                  "    'total', 'aprovacoes', 'reprovacoes', 'falhas', 'replays', 'taxa_aprovacao',",
