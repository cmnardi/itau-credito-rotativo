    {
      "name": "02 · Avaliações — variações aprovado/reprovado",
      "item": [
        {
          "name": "POST /avaliacoes — aprovado (30 pts)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{base_url}}/avaliacoes",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "avaliacoes"
              ]
            },
            "body": {
              "mode": "raw",
              "raw": "{\n  \"nome\": \"Ana Silva\",\n  \"cpf\": \"910.220.330-01\",\n  \"score_credito\": 750,\n  \"atrasos_meses\": 0,\n  \"valor_fatura\": \"1000.00\",\n  \"limite_disponivel\": \"4000.00\",\n  \"gastos_ultimos_meses\": [\n    \"1000.00\",\n    \"1200.00\",\n    \"900.00\",\n    \"1100.00\",\n    \"1000.00\",\n    \"1000.00\"\n  ]\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            }
          },
          "response": [],
          "description": "**Aprovado com todas as regras.** Score 750 (≥600), 0 atrasos, uso do limite 20% (1000/5000, dentro da banda 10–90% → +10), variação de gastos 0,11 (≤0,30 → +10) e fatura 1000 ≤ média 1033 × 1,5 (+10) = **30 de 30 pontos**.\n\nValor: `min(1000 × 1.0, 5000 × 0.50, 10000) × ajuste(30/30) = 1000.00`.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('status == aprovado', () => pm.expect(r.status).to.eql('aprovado'));",
                  "pm.test('valor_liberado == 1000.00 (fatura cheia: ajuste 1.0 com 30/30 pts)', () =>",
                  "  pm.expect(r.valor_liberado).to.eql('1000.00'));",
                  "pm.test('sem motivos (nada pendente contra o cliente)', () =>",
                  "  pm.expect(r.motivos).to.be.an('array').that.is.empty);",
                  "pm.test('as 5 regras aplicadas, em ordem (bloqueios antes do scoring)', () =>",
                  "  pm.expect(r.regras_aplicadas).to.eql([",
                  "    'ScoreMinimoRule', 'HistoricoAtrasosRule', 'UtilizacaoLimiteRule',",
                  "    'EstabilidadeGastosRule', 'PerfilGastosRule',",
                  "  ]));",
                  "pm.test('idempotency_key é SHA-256 (64 hex)', () =>",
                  "  pm.expect(r.idempotency_key).to.match(/^[0-9a-f]{64}$/));",
                  "pm.test('LGPD: resposta sem CPF em claro', () =>",
                  "  pm.expect(pm.response.text()).to.not.match(/\\d{3}\\.\\d{3}\\.\\d{3}-\\d{2}/));"
                ]
              }
            }
          ]
        },
