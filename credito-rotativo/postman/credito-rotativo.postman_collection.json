          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('status == aprovado (mesmo com alerta nos motivos)', () =>",
                  "  pm.expect(r.status).to.eql('aprovado'));",
