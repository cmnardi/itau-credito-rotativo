          "response": [],
          "description": "**Bloqueio da R1**: score 520 < mínimo 600. A cadeia faz **short-circuit** — nenhuma regra é registrada em `regras_aplicadas` e nada além da R1 é avaliado.",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "const r = pm.response.json();",
                  "pm.test('HTTP 200 (reprovado é resultado válido, não erro)', () => pm.response.to.have.status(200));",
                  "pm.test('status == reprovado', () => pm.expect(r.status).to.eql('reprovado'));",
                  "pm.test('motivo aponta o score mínimo', () => pm.expect(r.motivos[0]).to.eql('score 520 < mínimo 600'));",
                  "pm.test('short-circuit: cadeia parou na R1 (nenhuma regra registrada)', () =>",
                  "  pm.expect(r.regras_aplicadas).to.be.an('array').that.is.empty);",
                  "pm.test('reprovado não libera valor', () => pm.expect(r.valor_liberado).to.eql('0.00'));"
                ]
              }
            }
