                  "pm.test('POST /avaliacoes documenta os 3 exemplos (aprovado/reprovações)', () => {",
                  "  const exemplos = spec.paths['/avaliacoes'].post.requestBody.content['application/json'].examples;",
                  "  pm.expect(Object.keys(exemplos)).to.have.members([",
                  "    'cliente_aprovado', 'reprovado_por_score', 'reprovado_por_atrasos',",
                  "  ]);",
                  "});"
                ]
              }
            }
