                  "pm.test('invariante: aprovacoes + reprovacoes == total (decisões novas)', () =>",
                  "  pm.expect(r.aprovacoes + r.reprovacoes).to.eql(r.total));",
                  "pm.test('taxa_aprovacao coerente com os totais', () =>",
                  "  pm.expect(r.taxa_aprovacao).to.be.closeTo(r.total ? r.aprovacoes / r.total : 0, 0.0001));",
                  "pm.test('latência: p50 <= p95', () => pm.expect(r.latencia_p50_ms).to.be.at.most(r.latencia_p95_ms));",
                  "pm.test('status coerente com a presença de alertas', () =>",
                  "  pm.expect(r.status).to.eql(r.alertas.length > 0 ? 'alerta' : 'ok'));",
                  "pm.test('alertas só com códigos conhecidos', () =>",
                  "  r.alertas.forEach(a => pm.expect([",
                  "    'latencia_p95_acima_do_slo', 'taxa_de_erro_acima_do_limite', 'taxa_de_reprovacao_anomala',",
                  "  ]).to.include(a.codigo)));",
